{
  "realm": "payflow",
  "displayName": "PayFlow (local sandbox)",
  "enabled": true,

  "sslRequired": "none",

  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "bruteForceProtected": true,

  "roles": {
    "realm": [
      {"name": "payment:read"},
      {"name": "payment:write"},
      {"name": "operations:write"},
      {"name": "merchant:read"},
      {"name": "merchant:write"},
      {"name": "merchant:read:any"},
      {"name": "merchant:write:any"},
      {"name": "reporting:read"},
      {"name": "reporting:rebuild"},
      {"name": "webhook:retry"},
      {"name": "settlement:read"},
      {"name": "settlement:run"},
      {"name": "reconciliation:read"},
      {"name": "reconciliation:run"},
      {
        "name": "MERCHANT_ADMIN",
        "description": "Merchant operator allowed to read and mutate resources owned by one merchant.",
        "composite": true,
        "composites": {"realm": [
          "payment:read", "payment:write", "merchant:read", "merchant:write",
          "reporting:read", "settlement:read"
        ]}
      },
      {
        "name": "MERCHANT_USER",
        "description": "Read-only merchant member restricted to resources owned by one merchant.",
        "composite": true,
        "composites": {"realm": [
          "payment:read", "merchant:read", "reporting:read", "settlement:read"
        ]}
      },
      {
        "name": "OPERATIONS",
        "description": "Platform operations user for audited review, recovery and settlement actions.",
        "composite": true,
        "composites": {"realm": [
          "operations:write", "merchant:read:any", "merchant:write:any",
          "reporting:read", "reporting:rebuild", "webhook:retry",
          "settlement:read", "settlement:run", "reconciliation:read", "reconciliation:run"
        ]}
      }
    ]
  },

  "clientScopes": [
    {
      "name": "payment:read",
      "description": "Read payment resources. Does not permit creating or mutating a payment.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "payment:write",
      "description": "Create and mutate payment resources.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "operations:write",
      "description": "Resolve payment manual-review work items through audited operations APIs.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "merchant:read",
      "description": "Read merchant-owned configuration.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:write",
      "description": "Manage merchant-owned configuration, API keys and webhooks.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:write:any",
      "description": "Create and administer merchant records.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:internal:read",
      "description": "Read webhook signing configuration from private service routes.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reporting:read",
      "description": "Read merchant-scoped reporting projections.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reporting:rebuild",
      "description": "Run an audited reporting generation rebuild.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "webhook:retry",
      "description": "Requeue a terminal webhook delivery through the audited operations API.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "settlement:read",
      "description": "Read merchant-owned settlement batches.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "settlement:run",
      "description": "Calculate and complete audited settlement batches.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reconciliation:read",
      "description": "Read settlement reconciliation issues.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reconciliation:run",
      "description": "Run an audited reconciliation without automatic financial correction.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    }
  ],

  "clients": [
    {
      "clientId": "payflow-console",
      "name": "PayFlow browser console (local)",
      "description": "Public Authorization Code + PKCE client. It has no client secret and receives only roles assigned to the signed-in user.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "${PAYFLOW_CONSOLE_ORIGIN}",
      "baseUrl": "/console.html",
      "redirectUris": ["${PAYFLOW_CONSOLE_ORIGIN}/console.html"],
      "webOrigins": ["${PAYFLOW_CONSOLE_ORIGIN}"],
      "defaultClientScopes": [],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "usermodel.realmRoleMapping.rolePrefix": "",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "merchant-id-from-user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "merchant_id",
            "claim.name": "merchant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "900",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PAYFLOW_CONSOLE_ORIGIN}/console.html"
      }
    },
    {
      "clientId": "payflow-service",
      "name": "PayFlow service client (local)",
      "description": "Confidential client for client_credentials access to the PayFlow API.",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,

      "serviceAccountsEnabled": true,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "secret": "${PAYFLOW_SERVICE_CLIENT_SECRET}",

      "defaultClientScopes": [
        "basic",
        "payment:read",
        "payment:write",
        "merchant:read",
        "merchant:write",
        "reporting:read",
        "settlement:read"
      ],
      "optionalClientScopes": [],

      "protocolMappers": [
        {
          "name": "local-merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "merchant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],

      "attributes": {
        "access.token.lifespan": "900"
      }
    },

    {
      "clientId": "payflow-readonly",
      "name": "PayFlow read-only client (local)",
      "description": "Holds payment:read only. Exists so a test can prove that a missing scope produces 403 rather than 200, using a real token instead of a hand-built one.",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,

      "serviceAccountsEnabled": true,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "secret": "${PAYFLOW_READONLY_CLIENT_SECRET}",

      "defaultClientScopes": [
        "basic",
        "payment:read"
      ],
      "optionalClientScopes": [],

      "protocolMappers": [
        {
          "name": "local-merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "merchant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],

      "attributes": {
        "access.token.lifespan": "900"
      }
    },
    {
      "clientId": "payflow-operations",
      "name": "PayFlow operations client (local)",
      "description": "Local confidential client isolated from merchant scopes.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_OPERATIONS_CLIENT_SECRET}",
      "defaultClientScopes": [
        "basic",
        "operations:write",
        "merchant:write:any",
        "reporting:rebuild",
        "webhook:retry",
        "settlement:run",
        "reconciliation:read",
        "reconciliation:run"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "900"
      }
    },
    {
      "clientId": "payflow-notification",
      "name": "PayFlow notification service client (local)",
      "description": "Least-privileged client for private merchant webhook configuration lookup.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_NOTIFICATION_CLIENT_SECRET}",
      "defaultClientScopes": ["basic", "merchant:internal:read"],
      "optionalClientScopes": [],
      "attributes": {"access.token.lifespan": "300"}
    },
    {
      "clientId": "payflow-payment-internal",
      "name": "PayFlow payment internal client (local)",
      "description": "Least-privileged Payment client for reading the Merchant-owned intake policy.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_PAYMENT_INTERNAL_CLIENT_SECRET}",
      "defaultClientScopes": ["basic", "merchant:internal:read"],
      "optionalClientScopes": [],
      "attributes": {"access.token.lifespan": "300"}
    }
  ],
  "users": [
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1",
      "username": "merchant.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Merchant",
      "lastName": "Admin",
      "email": "merchant.admin@payflow.local",
      "attributes": {"merchant_id": ["11111111-1111-4111-8111-111111111111"]},
      "realmRoles": ["MERCHANT_ADMIN"],
      "credentials": [{"type": "password", "value": "${PAYFLOW_MERCHANT_ADMIN_PASSWORD}", "temporary": false}]
    },
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2",
      "username": "merchant.user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Merchant",
      "lastName": "User",
      "email": "merchant.user@payflow.local",
      "attributes": {"merchant_id": ["11111111-1111-4111-8111-111111111111"]},
      "realmRoles": ["MERCHANT_USER"],
      "credentials": [{"type": "password", "value": "${PAYFLOW_MERCHANT_USER_PASSWORD}", "temporary": false}]
    },
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3",
      "username": "operations.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Operations",
      "lastName": "Admin",
      "email": "operations.admin@payflow.local",
      "realmRoles": ["OPERATIONS"],
      "credentials": [{"type": "password", "value": "${PAYFLOW_OPERATIONS_USER_PASSWORD}", "temporary": false}]
    }
  ]
}

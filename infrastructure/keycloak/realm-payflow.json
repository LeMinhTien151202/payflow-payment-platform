{
  "realm": "payflow",
  "displayName": "PayFlow (local sandbox)",
  "enabled": true,

  "sslRequired": "none",

  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "bruteForceProtected": true,

  "clientScopes": [
    {
      "name": "payment:read",
      "description": "Read payment resources. Does not permit creating or mutating a payment.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "payment:write",
      "description": "Create and mutate payment resources.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "operations:write",
      "description": "Resolve payment manual-review work items through audited operations APIs.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "merchant:read",
      "description": "Read merchant-owned configuration.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:write",
      "description": "Manage merchant-owned configuration, API keys and webhooks.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:write:any",
      "description": "Create and administer merchant records.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "merchant:internal:read",
      "description": "Read webhook signing configuration from private service routes.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reporting:read",
      "description": "Read merchant-scoped reporting projections.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "reporting:rebuild",
      "description": "Run an audited reporting generation rebuild.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    },
    {
      "name": "webhook:retry",
      "description": "Requeue a terminal webhook delivery through the audited operations API.",
      "protocol": "openid-connect",
      "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
    }
  ],

  "clients": [
    {
      "clientId": "payflow-service",
      "name": "PayFlow service client (local)",
      "description": "Confidential client for client_credentials access to the PayFlow API.",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,

      "serviceAccountsEnabled": true,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "secret": "${PAYFLOW_SERVICE_CLIENT_SECRET}",

      "defaultClientScopes": [
        "basic",
        "payment:read",
        "payment:write",
        "merchant:read",
        "merchant:write",
        "reporting:read"
      ],
      "optionalClientScopes": [],

      "protocolMappers": [
        {
          "name": "local-merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "merchant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],

      "attributes": {
        "access.token.lifespan": "900"
      }
    },

    {
      "clientId": "payflow-readonly",
      "name": "PayFlow read-only client (local)",
      "description": "Holds payment:read only. Exists so a test can prove that a missing scope produces 403 rather than 200, using a real token instead of a hand-built one.",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "bearerOnly": false,

      "serviceAccountsEnabled": true,

      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,

      "secret": "${PAYFLOW_READONLY_CLIENT_SECRET}",

      "defaultClientScopes": [
        "basic",
        "payment:read"
      ],
      "optionalClientScopes": [],

      "protocolMappers": [
        {
          "name": "local-merchant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "merchant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],

      "attributes": {
        "access.token.lifespan": "900"
      }
    },
    {
      "clientId": "payflow-operations",
      "name": "PayFlow operations client (local)",
      "description": "Local confidential client isolated from merchant scopes.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_OPERATIONS_CLIENT_SECRET}",
      "defaultClientScopes": [
        "basic",
        "operations:write",
        "merchant:write:any",
        "reporting:rebuild",
        "webhook:retry"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "access.token.lifespan": "900"
      }
    },
    {
      "clientId": "payflow-notification",
      "name": "PayFlow notification service client (local)",
      "description": "Least-privileged client for private merchant webhook configuration lookup.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_NOTIFICATION_CLIENT_SECRET}",
      "defaultClientScopes": ["basic", "merchant:internal:read"],
      "optionalClientScopes": [],
      "attributes": {"access.token.lifespan": "300"}
    },
    {
      "clientId": "payflow-payment-internal",
      "name": "PayFlow payment internal client (local)",
      "description": "Least-privileged Payment client for reading the Merchant-owned intake policy.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "${PAYFLOW_PAYMENT_INTERNAL_CLIENT_SECRET}",
      "defaultClientScopes": ["basic", "merchant:internal:read"],
      "optionalClientScopes": [],
      "attributes": {"access.token.lifespan": "300"}
    }
  ]
}

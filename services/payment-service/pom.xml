<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.payflow</groupId>
        <artifactId>payflow-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>payment-service</artifactId>
    <name>PayFlow Payment Service</name>
    <description>
        Owns payment/refund lifecycle, idempotency, and Saga orchestration. Phase 1A implements
        merchant-scoped payment intake, status history, transactional outbox, persisted Saga,
        idempotent workflow consumers, and bounded recovery; refund remains roadmap-gated.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <!--
            Required by the resource server, and not pulled in by it. Boot 4 splits the HTTP client
            support into its own module, and spring-boot-security-oauth2-resource-server declares no
            dependency on it; without this the JwtDecoder auto-configuration dies with
            ClassNotFoundException: ClientHttpRequestFactoryBuilder, and the security filter chain
            fails to build. Slice tests hide it because they supply a mock JwtDecoder.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            The starter, not a bare org.springframework.kafka:spring-kafka. Boot 4 moved every
            auto-configuration out of spring-boot-autoconfigure into a per-technology module, so
            spring-kafka alone puts KafkaTemplate on the classpath while leaving no bean of that type
            in the context. The failure is not at compile time: it is an UnsatisfiedDependencyException
            when the application context starts.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Flyway owns the schema. Hibernate only validates it. -->
        <!-- The starter, not bare flyway-core. Boot 4 moved Flyway auto-configuration into its own
             module, so flyway-core alone leaves migrations un-run and Hibernate validating an empty
             schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.payflow</groupId>
            <artifactId>observability-support</artifactId>
        </dependency>
        <dependency>
            <groupId>com.payflow</groupId>
            <artifactId>error-contract</artifactId>
        </dependency>
        <!--
          Event names, versions, and the envelope. payment-service owns the payment contracts in this
          module; it depends on the module rather than defining them locally so a consumer never has to
          depend on a producer's internals.
        -->
        <dependency>
            <groupId>com.payflow</groupId>
            <artifactId>event-contracts</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Real PostgreSQL for migration and constraint tests. TESTING_STRATEGY.md forbids proving
          PostgreSQL behaviour with H2, so there is deliberately no H2 dependency here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Baseline nền tảng được khóa bởi docs/adr/ADR-013-platform-version-baseline.md.
      Spring Boot 4.0.7 đi kèm với Spring Cloud 2025.1.2: release train đó khai báo
      <spring-boot.version>4.0.7</spring-boot.version>. Không nâng Boot lên 4.1.x cho tới khi có một
      Spring Cloud release train hướng tới nó, và tuyệt đối không trộn lẫn các release train.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.payflow</groupId>
    <artifactId>payflow-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PayFlow Parent</name>
    <description>Sandbox payment platform: parent aggregator và dependency lock</description>

    <modules>
        <module>libs/observability-support</module>
        <module>libs/error-contract</module>
        <module>libs/event-contracts</module>
        <module>libs/network-security-support</module>
        <module>services/api-gateway</module>
        <module>services/payment-service</module>
        <module>services/account-ledger-service</module>
        <module>services/account-service</module>
        <module>services/ledger-service</module>
        <module>services/merchant-service</module>
        <module>services/reporting-service</module>
        <module>services/settlement-service</module>
        <module>services/risk-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>

        <!-- Được quản lý bởi Boot BOM; ghim ở đây cho những trường hợp BOM không quản lý. -->
        <wiremock.version>3.13.1</wiremock.version>

        <!--
          Mặc định rỗng: `mvnw verify` chạy mọi integration test, bao gồm cả những bài test
          khởi động một container thực sự. Failsafe bỏ qua một giá trị excludedGroups rỗng.
          Profile `no-docker` bên dưới sẽ đặt giá trị cho nó, do đó hãy giữ giá trị này rỗng ở đây.
        -->
        <payflow.failsafe.excludedGroups/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Việc hỗ trợ Spring Boot 4 bắt đầu từ springdoc 3.x. Giữ phiên bản tập trung để
                 mọi service sở hữu REST trong tương lai đều publish contract với cùng một toolchain. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>observability-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>error-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>network-security-support</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Mỗi module đều nhận bộ test baseline: JUnit 5, AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Surefire chạy các bài test nhanh không có dependency bên ngoài: unit, domain, và
                  các bài slice test web/security. Các bài test này phải pass mà không cần Docker.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!--
                  Failsafe chạy *IT: các bài test boot cả một application context hoàn chỉnh, hoặc cần một
                  dependency bên ngoài như WireMock stub hay Testcontainers database.

                  Chỉ những bài test dựa trên Testcontainers mới cần Docker daemon đang chạy. Việc phân tách là
                  dựa trên chi phí và phạm vi ảnh hưởng, chứ không phải bài test nào cần Docker, để `mvnw test`
                  giữ tốc độ đủ nhanh để chạy mỗi lần save trong khi `mvnw verify` mới là gate thực sự.
                  TESTING_STRATEGY.md cấm chứng minh hành vi PostgreSQL bằng H2.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <excludedGroups>${payflow.failsafe.excludedGroups}</excludedGroups>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          `./mvnw -Pno-docker verify` — gate hoàn chỉnh trừ những bài test cần Docker daemon.
          Hữu ích trước khi hạ tầng được khởi chạy ở local, và đóng vai trò kiểm tra nhanh trước khi push.

          Đây là tùy chọn tham gia (opt-in) cố ý. Lệnh `verify` mặc định bao gồm cả các bài test dựa trên container, do đó
          không ai có thể pass gate thực sự nếu chưa chạy chúng; một dev muốn bỏ qua chúng phải chỉ định rõ trên câu lệnh.
          Các bài test có tag @Tag("docker") là các bài test bị loại trừ — xem PaymentServiceFoundationIT và docs/runbooks/local-development.md.
        -->
        <profile>
            <id>no-docker</id>
            <properties>
                <payflow.failsafe.excludedGroups>docker</payflow.failsafe.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>

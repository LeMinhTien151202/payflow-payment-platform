<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Platform baseline is locked by docs/adr/ADR-013-platform-version-baseline.md.
      Spring Boot 4.0.7 pairs with Spring Cloud 2025.1.2: that release train declares
      <spring-boot.version>4.0.7</spring-boot.version>. Do not bump Boot to 4.1.x until a
      Spring Cloud release train targets it, and never mix release trains.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.payflow</groupId>
    <artifactId>payflow-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>PayFlow Parent</name>
    <description>Sandbox payment platform: parent aggregator and dependency lock</description>

    <modules>
        <module>libs/observability-support</module>
        <module>libs/error-contract</module>
        <module>libs/event-contracts</module>
        <module>services/api-gateway</module>
        <module>services/payment-service</module>
        <module>services/account-ledger-service</module>
        <module>services/risk-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <springdoc-openapi.version>3.0.3</springdoc-openapi.version>

        <!-- Managed by the Boot BOM; pinned here only where the BOM does not manage them. -->
        <wiremock.version>3.13.1</wiremock.version>

        <!--
          Empty by default: `mvnw verify` runs every integration test, including the ones that
          start a real container. Failsafe ignores a blank excludedGroups.
          The `no-docker` profile below sets it, so keep this empty here.
        -->
        <payflow.failsafe.excludedGroups/>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Boot 4 support starts with springdoc 3.x. Keep the version centralized so
                 every future REST-owning service publishes contracts with the same toolchain. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>observability-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>error-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payflow</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every module gets the test baseline: JUnit 5, AssertJ, Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Surefire runs fast tests with no external dependency: unit, domain, and
                  web/security slice tests. These must pass without Docker.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>**/*IT.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <!--
                  Failsafe runs *IT: tests that boot a full application context, or need an
                  external dependency such as a WireMock stub or a Testcontainers database.

                  Only the Testcontainers-backed ones need a running Docker daemon. The split is
                  by cost and blast radius, not by which tests need Docker, so that `mvnw test`
                  stays fast enough to run on every save while `mvnw verify` is the real gate.
                  TESTING_STRATEGY.md forbids proving PostgreSQL behaviour with H2.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*IT.java</include>
                        </includes>
                        <excludedGroups>${payflow.failsafe.excludedGroups}</excludedGroups>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          `./mvnw -Pno-docker verify` — the full gate minus anything that needs a Docker daemon.
          Useful before infrastructure is running locally, and as the fast pre-push check.

          It is deliberately opt-in. The default `verify` includes the container-backed tests, so
          nobody can pass the real gate without having run them; a developer who skips them has to
          say so on the command line. Tests carrying @Tag("docker") are the ones excluded — see
          PaymentServiceFoundationIT and docs/runbooks/local-development.md.
        -->
        <profile>
            <id>no-docker</id>
            <properties>
                <payflow.failsafe.excludedGroups>docker</payflow.failsafe.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.payflow</groupId>
        <artifactId>payflow-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>event-contracts</artifactId>
    <name>PayFlow Event Contracts</name>
    <description>
        Kafka event envelope có version, tên các topic, và các schema payload event được dùng chung bởi các producer
        và consumer. MODULE_MAP.md cho phép "event envelope và schema contract ổn định" trong một shared
        library; nó cấm các domain service, state machine, và chính sách tiền tệ dùng chung, nên không có gì trong
        module này được phép chứa hành vi nghiệp vụ ngoài việc validate hợp đồng.
    </description>

    <dependencies>
        <!--
          Dành cho tên correlation id header và các quy tắc an toàn của nó. Envelope lưu trữ và log
          correlation id, do đó nó phải áp dụng cùng một quy tắc validation như ở ranh giới HTTP thay vì
          tự triển khai lại với một tập ký tự khác biệt nhỏ.
        -->
        <dependency>
            <groupId>com.payflow</groupId>
            <artifactId>observability-support</artifactId>
        </dependency>

        <!--
          Dành riêng cho phạm vi Test. Module này cố ý không chứa dependency JSON tại thời điểm biên dịch: wire
          format là một hợp đồng, chứ không phải lựa chọn thư viện, và không có gì ở đây sử dụng annotation. Jackson hiện
          diện để các bài test có thể chứng minh cấu trúc sau khi serialised thực sự khớp với spec 8.2 thay vì
          khẳng định điều đó trong một chú thích.
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

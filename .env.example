# Template biến môi trường local của PayFlow.
#
# Copy sang file .env và điền các giá trị dùng riêng cho local:
#   cp .env.example .env
#
# File .env đã được git-ignore. Mọi giá trị ở đây chỉ là placeholder cho môi trường sandbox local có thể hủy bỏ.
# Tuyệt đối không đưa credential thật, URL production hay shared secret vào bất kỳ file nào.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Superuser dành riêng cho container. User riêng cho từng service được khởi tạo bởi
# infrastructure/docker/postgres/init/01-create-databases.sh.
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# payment-service sở hữu database payflow_payment và kết nối bằng user riêng của nó.
PAYFLOW_PAYMENT_DB_URL=jdbc:postgresql://localhost:5433/payflow_payment
PAYFLOW_PAYMENT_DB_USERNAME=payflow_payment
PAYFLOW_PAYMENT_DB_PASSWORD=change-me-local-only

# Mỗi service chạy runtime sở hữu một database và thông tin đăng nhập riêng biệt. Việc tách biệt các credential này
# giúp cho truy vấn nhầm xuyên service thất bại ngay tại PostgreSQL thay vì phụ thuộc vào code review.
PAYFLOW_ACCOUNT_LEDGER_DB_URL=jdbc:postgresql://localhost:5433/payflow_account_ledger
PAYFLOW_ACCOUNT_LEDGER_DB_USERNAME=payflow_account_ledger
PAYFLOW_ACCOUNT_LEDGER_DB_PASSWORD=change-me-local-only

PAYFLOW_ACCOUNT_DB_URL=jdbc:postgresql://localhost:5433/payflow_account
PAYFLOW_ACCOUNT_DB_USERNAME=payflow_account
PAYFLOW_ACCOUNT_DB_PASSWORD=change-me-local-only

PAYFLOW_LEDGER_DB_URL=jdbc:postgresql://localhost:5433/payflow_ledger
PAYFLOW_LEDGER_DB_USERNAME=payflow_ledger
PAYFLOW_LEDGER_DB_PASSWORD=change-me-local-only

PAYFLOW_MERCHANT_DB_URL=jdbc:postgresql://localhost:5433/payflow_merchant
PAYFLOW_MERCHANT_DB_USERNAME=payflow_merchant
PAYFLOW_MERCHANT_DB_PASSWORD=change-me-local-only

PAYFLOW_REPORTING_DB_URL=jdbc:postgresql://localhost:5433/payflow_reporting
PAYFLOW_REPORTING_DB_USERNAME=payflow_reporting
PAYFLOW_REPORTING_DB_PASSWORD=change-me-local-only

PAYFLOW_RISK_DB_URL=jdbc:postgresql://localhost:5433/payflow_risk
PAYFLOW_RISK_DB_USERNAME=payflow_risk
PAYFLOW_RISK_DB_PASSWORD=change-me-local-only

PAYFLOW_NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5433/payflow_notification
PAYFLOW_NOTIFICATION_DB_USERNAME=payflow_notification
PAYFLOW_NOTIFICATION_DB_PASSWORD=change-me-local-only

# Keycloak lưu trữ các realm trong PostgreSQL chứ không phải in-memory database của dev-mode, do đó các chỉnh sửa
# realm ở local vẫn được giữ nguyên sau khi khởi động lại container.
KEYCLOAK_DB_NAME=payflow_keycloak
KEYCLOAK_DB_USERNAME=payflow_keycloak
KEYCLOAK_DB_PASSWORD=change-me-local-only

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_PORT=8180
PAYFLOW_OIDC_ISSUER_URI=http://localhost:8180/realms/payflow
# Ứng dụng chạy trên Host sử dụng URL này. Các container ứng dụng trong Compose chỉ ghi đè duy nhất giá trị này
# bằng keycloak:8080 trong khi vẫn giữ nguyên public issuer ở trên để kiểm tra `iss` nghiêm ngặt.
PAYFLOW_OIDC_JWK_SET_URI=http://localhost:8180/realms/payflow/protocol/openid-connect/certs

# Secret cho các confidential client. Đợt import realm đọc các biến này từ môi trường nên không có
# secret nào bị commit vào file infrastructure/keycloak/realm-payflow.json.
#   payflow-service  nắm quyền payment:read + payment:write
#   payflow-readonly chỉ nắm quyền payment:read, để chứng minh lỗi 403 được cưỡng chế
PAYFLOW_SERVICE_CLIENT_SECRET=change-me-local-only
PAYFLOW_READONLY_CLIENT_SECRET=change-me-local-only
PAYFLOW_OPERATIONS_CLIENT_SECRET=change-me-local-only
PAYFLOW_NOTIFICATION_CLIENT_SECRET=change-me-local-only
PAYFLOW_PAYMENT_INTERNAL_CLIENT_SECRET=change-me-local-only
# 32 zero bytes encoded only as a disposable local placeholder. Generate a new random 32-byte value
# for every non-disposable environment; never reuse this sample outside local sandbox.
PAYFLOW_MERCHANT_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---------------------------------------------------------------------------
# Kafka và Redis
# ---------------------------------------------------------------------------
# Được khởi tạo từ Phase 0 để hạ tầng gate có thể pass. Chưa có service nào tiêu thụ chúng cho đến khi
# Phase 1A giới thiệu outbox publisher.
KAFKA_PORT=9092
PAYFLOW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Lỗi request timeout của Kafka mặc định là 30s và linger mặc định là 5ms, do đó delivery timeout phải
# lớn hơn nghiêm ngặt so với tổng của chúng nếu không producer sẽ từ chối khởi chạy.
PAYFLOW_KAFKA_DELIVERY_TIMEOUT_MS=60000
REDIS_PORT=6379
PAYFLOW_REDIS_HOST=localhost
PAYFLOW_REDIS_PORT=6379
PAYFLOW_REDIS_TIMEOUT=2s

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
PAYFLOW_GATEWAY_PORT=8084
PAYFLOW_PAYMENT_PORT=8081
PAYFLOW_ACCOUNT_LEDGER_PORT=8082
PAYFLOW_ACCOUNT_PORT=8082
PAYFLOW_LEDGER_PORT=8086
PAYFLOW_MERCHANT_PORT=8087
PAYFLOW_REPORTING_PORT=8088
PAYFLOW_RISK_PORT=8083
PAYFLOW_NOTIFICATION_PORT=8085
PAYFLOW_PAYMENT_SERVICE_URI=http://localhost:8081

# Đặt false khi chạy payment-service mà không có Kafka. Việc tạo payment vẫn commit dòng outbox;
# bật publisher lại sau đó sẽ drain tiếp các dòng pending.
PAYFLOW_OUTBOX_ENABLED=true
PAYFLOW_OUTBOX_POLL_INTERVAL=500ms
PAYFLOW_OUTBOX_BATCH_SIZE=100
PAYFLOW_OUTBOX_LEASE=120s
PAYFLOW_OUTBOX_MAX_ATTEMPTS=10
PAYFLOW_OUTBOX_MAX_BACKOFF=300s

# Các công tắc Workflow được giữ cố định tường minh để lập trình viên có thể cô lập một service khi debug. Profile MVP
# để tất cả các công tắc là true; việc tắt một công tắc sẽ khiến gate payment end-to-end không thể pass.
PAYFLOW_WORKFLOW_CONSUMER_ENABLED=true
PAYFLOW_WORKFLOW_CONSUMER_RETRY_BACKOFF=1s
PAYFLOW_WORKFLOW_CONSUMER_MAX_RETRIES=3
PAYFLOW_SAGA_RECOVERY_ENABLED=true
PAYFLOW_SAGA_RECOVERY_POLL_INTERVAL=1s
PAYFLOW_SAGA_STEP_TIMEOUT=30s
PAYFLOW_SAGA_MAX_RETRIES=3
PAYFLOW_SAGA_RECOVERY_BATCH_SIZE=50
PAYFLOW_PAYMENT_CONSUMER_ENABLED=true
PAYFLOW_REFUND_CONSUMER_ENABLED=true
PAYFLOW_RISK_CONSUMER_ENABLED=true
PAYFLOW_RISK_VELOCITY_RETENTION=2h
PAYFLOW_NOTIFICATION_CONSUMER_ENABLED=true
PAYFLOW_NOTIFICATION_DELIVERY_ENABLED=true
PAYFLOW_NOTIFICATION_POLL_INTERVAL=500ms
PAYFLOW_NOTIFICATION_BATCH_SIZE=50
PAYFLOW_NOTIFICATION_LEASE=30s
PAYFLOW_NOTIFICATION_PROVIDER_TIMEOUT=5s
PAYFLOW_NOTIFICATION_MAX_ATTEMPTS=5
PAYFLOW_ACCOUNT_CONSUMER_ENABLED=true
PAYFLOW_LEDGER_CONSUMER_ENABLED=true
PAYFLOW_REPORTING_CONSUMER_ENABLED=true
PAYFLOW_WEBHOOK_ENABLED=true
PAYFLOW_WEBHOOK_POLL_INTERVAL=1s
PAYFLOW_WEBHOOK_BATCH_SIZE=25
PAYFLOW_WEBHOOK_LEASE=30s
PAYFLOW_WEBHOOK_HTTP_TIMEOUT=5s
PAYFLOW_MERCHANT_SERVICE_URI=http://localhost:8087
PAYFLOW_SERVICE_TOKEN_URI=http://localhost:8180/realms/payflow/protocol/openid-connect/token
PAYFLOW_NOTIFICATION_CLIENT_ID=payflow-notification
PAYFLOW_PAYMENT_INTERNAL_CLIENT_ID=payflow-payment-internal
PAYFLOW_MERCHANT_CATALOG_MODE=remote
PAYFLOW_MERCHANT_HTTP_TIMEOUT=3s
